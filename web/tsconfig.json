{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": false,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "tests", "tools/ai-desk.ts", "tools/ai-providers.ts", "vite.config.ts", "playwright.config.ts"]
}
