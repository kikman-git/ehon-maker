# Copy to .env.local (ignored by Git). Leave everything empty for a local-only book maker.

# Local emulators (make emulators). Overrides every other setting below.
# VITE_EMULATOR_HOST=127.0.0.1

# A provisioned Firebase project (see backend/README.md). Web API keys are public identifiers.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
# reCAPTCHA Enterprise site key registered for App Check.
VITE_APPCHECK_SITE_KEY=
# Defaults to https://asia-northeast1-<project>.cloudfunctions.net
VITE_FUNCTIONS_URL=
# The assets Worker domain, e.g. https://assets-dev.example.com
VITE_ASSETS_URL=
# Where the woff2 font slices are served from; defaults to this site's /fonts (see web/README.md).
VITE_FONTS_URL=
