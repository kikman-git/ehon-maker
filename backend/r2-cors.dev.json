{
  "rules": [{
    "allowed": {
      "origins": ["https://petapeta-dev.pages.dev", "http://localhost:5173", "http://127.0.0.1:5173", "http://127.0.0.1:4173"],
      "methods": ["GET", "PUT", "HEAD"],
      "headers": ["Content-Type", "x-amz-checksum-sha256"]
    },
    "exposeHeaders": ["ETag"],
    "maxAgeSeconds": 3600
  }]
}
