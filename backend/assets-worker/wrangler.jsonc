{
  "name": "ehon-assets",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ehon-assets-dev" }],
  "env": {
    "prod": { "name": "ehon-assets-prod", "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "ehon-assets-prod" }] }
  }
}
